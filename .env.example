APP_NAME="Blue3 Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco: MySQL/MariaDB (nunca SQLite — ver CLAUDE.md da Blue3).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blue3_online
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="status@blue3.online"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Matomo Analytics (self-hosted em a.blue3.cloud) ───────────────────────────
# Rastreamento da página pública de status. O snippet só entra no <head> quando
# MATOMO_ENABLED=true E MATOMO_SITE_ID preenchido (config/services.php +
# partials/matomo.blade.php). Após ativar: php artisan config:cache.
MATOMO_ENABLED=false
MATOMO_URL=https://a.blue3.cloud/
MATOMO_SITE_ID=7

# ── Deploy (lidos pelo deploy.sh) ─────────────────────────────────────────────
DEPLOY_APP_USER=b3sys
DEPLOY_WEB_USER=www-data
DEPLOY_BRANCH=master
DEPLOY_BACKUP=0
DEPLOY_TELEGRAM_BOT_TOKEN=
DEPLOY_TELEGRAM_CHAT_ID=
